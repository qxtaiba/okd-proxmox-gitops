{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    'docker:pinDigests',
    'helpers:pinGitHubActionDigests',
    ':dependencyDashboard',
    ':semanticCommits',
    ':disableRateLimiting',
    'github>qxtaiba/okd-proxmox-gitops//.github/renovate/autoMerge.json5',
    'github>qxtaiba/okd-proxmox-gitops//.github/renovate/labels.json5',
    'github>qxtaiba/okd-proxmox-gitops//.github/renovate/groups.json5',
    'github>qxtaiba/okd-proxmox-gitops//.github/renovate/semanticCommits.json5',
    'github>qxtaiba/okd-proxmox-gitops//.github/renovate/customManagers.json5',
  ],
  dependencyDashboard: {
    title: 'Renovate Dashboard 🤖',
  },
  rebaseWhen: 'auto',
  commitMessageLowerCase: 'auto',
  timezone: 'UTC',
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  flux: {
    managerFilePatterns: [
      '/kubernetes/.+\\.ya?ml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/kubernetes/.+\\.ya?ml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/kubernetes/.+\\.ya?ml$/',
    ],
  },
  packageRules: [
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'quay.io/ceph/ceph',
      ],
      allowedVersions: '/^v\\d+\\.2\\.\\d+$/',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'quay.io/openshift/origin-keepalived-ipfailover',
        'quay.io/openshift/origin-cli',
      ],
      allowedVersions: '<5',
    },
    {
      matchPackageNames: [
        'quay.io/openshift/origin-keepalived-ipfailover',
        'ghcr.io/controlplaneio-fluxcd/flux-operator-manifests',
      ],
      pinDigests: false,
    },
  ],
}
