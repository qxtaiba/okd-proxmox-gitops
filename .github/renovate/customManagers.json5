{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      // .yml covers CI workflow tool pins (e.g. BUTANE_VERSION in ci.yml).
      "description": "Process annotated dependencies in YAML files",
      "managerFilePatterns": [
        "/\\.yaml$/",
        "/\\.yml$/"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}"
    },
    {
      "customType": "regex",
      // Images embedded in Butane sources (e.g. the keepalived static pod)
      // are invisible to the flux/kubernetes managers because the rendered
      // MachineConfig gzips them. The butane-drift CI job fails any bump
      // whose rendered machineconfig.yaml was not regenerated to match.
      "description": "Process container images in Butane files",
      "managerFilePatterns": [
        "/\\.bu$/"
      ],
      "matchStrings": [
        "image: (?<depName>[^:\\s]+):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Process OCI repository references",
      "managerFilePatterns": [
        "/\\.yaml$/"
      ],
      "matchStrings": [
        "oci://(?<depName>[^:]+):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Process grafana.com dashboard revisions",
      "managerFilePatterns": [
        "/\\.yaml$/"
      ],
      "matchStrings": [
        "url: https://grafana\\.com/api/dashboards/(?<depName>\\d+)/revisions/(?<currentValue>\\d+)/download"
      ],
      "datasourceTemplate": "custom.grafana-dashboards",
      // Revisions are plain integers; every one is a "major" so dashboard
      // bumps get a PR to eyeball instead of automerging.
      "versioningTemplate": "regex:^(?<major>\\d+)$"
    }
  ],
  "customDatasources": {
    "grafana-dashboards": {
      "defaultRegistryUrlTemplate": "https://grafana.com/api/dashboards/{{packageName}}",
      "format": "json",
      "transformTemplates": [
        "{\"releases\":[{\"version\": $string(revision)}]}"
      ]
    }
  }
}
