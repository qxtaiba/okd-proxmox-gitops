{
  "packageRules": [
    {
      "description": "automerge non-major updates",
      "matchManagers": ["*"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "rebase"
    },
    {
      // Broken releases are usually yanked or patched within a day or two of
      // publishing. Automerge used to land them the moment they appeared;
      // hold version bumps until they have survived 3 days in the wild.
      // Digest updates carry no release timestamp, so they are excluded
      // rather than held forever.
      "description": "let releases age before automerging",
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "3 days"
    },
    {
      // Chart OCIRepositories pinned by `ref.digest` reconcile fine in Flux,
      // but flux-local (CI validate-flux) passes the digest to
      // `helm template --version`, which rejects it ("improper constraint").
      // Container images keep digest pins; charts stay on tags.
      "description": "no digest pins for flux chart sources",
      "matchManagers": ["flux"],
      "pinDigests": false
    }
  ]
}
